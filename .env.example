# ==============================================================================
# APEX SCHOOL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting the Docker containers:
# cp .env.example .env
# ==============================================================================

# --- Django Core Configuration ---
DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-2026
DJANGO_SETTINGS_MODULE=config.settings
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,web
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost

# --- PostgreSQL Database ---
USE_POSTGRES=True
POSTGRES_DB=school_management_db
POSTGRES_USER=sms_user
POSTGRES_PASSWORD=sms_secure_password_2026
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://sms_user:sms_secure_password_2026@db:5432/school_management_db

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Automatic Startup Seeding ---
# Set to True on first deployment to seed administrative accounts, classes, and notifications
SEED_DATABASE_ON_STARTUP=True

# --- Next.js Frontend Configuration ---
NODE_ENV=production
NEXT_PUBLIC_API_URL=/api/v1
NEXT_TELEMETRY_DISABLED=1

# --- Security & JWT Lifetimes ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=120
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
